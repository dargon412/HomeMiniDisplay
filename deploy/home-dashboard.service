[Unit]
Description=Home Dashboard server (static + shared-state API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change User/WorkingDirectory to match where you cloned the repo.
User=pi
WorkingDirectory=/home/pi/HomeMiniDisplay
ExecStart=/usr/bin/python3 /home/pi/HomeMiniDisplay/server/server.py
Environment=HD_PORT=8080
Environment=HD_BIND=127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
